# Contact form email (Resend). Copy to .env.local and fill in.
# .env.local is gitignored — never commit real keys.

# Required: Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Optional: sender address. Must be on a domain you've verified in Resend.
# Leave blank to use Resend's shared sender (works immediately, but lands as
# onboarding@resend.dev). Once ritikbora.dev is verified, set e.g.:
# CONTACT_FROM=Ritik Bora <contact@ritikbora.dev>
CONTACT_FROM=
